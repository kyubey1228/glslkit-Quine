<!doctype html>
<html lang="ja">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>OUROBOROS — frame.frag ビューア</title>
<style>html,body{margin:0;width:100%;height:100%;background:#080e0e;color:#d7ddcc;font:14px system-ui,sans-serif}canvas{position:fixed;inset:0;width:100%;height:100%}.panel{position:relative;z-index:1;padding:24px;background:linear-gradient(#080e0ef0,transparent);pointer-events:none}h1{font:24px Georgia,serif;letter-spacing:.12em;margin:0 0 14px}.panel>*{pointer-events:auto}label{display:inline-block;padding:10px 16px;border:1px solid #637668;background:#13201de0;cursor:pointer}input{position:absolute;opacity:0;width:1px;height:1px}label:focus-within{outline:2px solid #c0ac7a}p{font-size:12px;color:#9baaa0;line-height:1.8}#status{color:#c0ac7a;white-space:pre-wrap}a{color:inherit}.drop{outline:2px solid #c0ac7a;outline-offset:-8px}</style></head>
<body><canvas id="art" aria-label="選んだフラグメントシェーダーの描画"></canvas><div class="panel"><h1>OUROBOROS / FRAME VIEWER</h1><label>frame.frag を選ぶ<input id="file" type="file" accept=".frag,text/plain"></label><p>ファイルを選ぶか、ここにドラッグしてください。保存した1世代の姿を表示します。<br>世代が巡る作品は <a id="work-link" href="/">作品画面</a>で再生できます。</p><p id="status" role="status">まだファイルを選んでいません。</p></div>
<script>
'use strict';
__SHADER_DATA__
if(location.protocol==='file:')document.getElementById('work-link').href='../index.html';
const vertex=__VERTEX__;
// Uniform setters were generated by glslkit for the OUROBOROS shader interface.
const manifest=__MANIFEST__;
const canvas=document.getElementById('art'),status=document.getElementById('status'),gl=canvas.getContext('webgl2',{alpha:false,antialias:false});
let program,shaderData,uniforms,pointer=new Float32Array([0,0]),loading=0;
function compile(type,source){const shader=gl.createShader(type);gl.shaderSource(shader,source);gl.compileShader(shader);if(!gl.getShaderParameter(shader,gl.COMPILE_STATUS)){const error=gl.getShaderInfoLog(shader);gl.deleteShader(shader);throw new Error(error);}return shader;}
function draw(){if(!program)return;gl.useProgram(program);gl.viewport(0,0,canvas.width,canvas.height);uniforms.u_resolution(new Float32Array([canvas.width,canvas.height]));uniforms.u_pointer(pointer);uniforms.u_mode(1);gl.drawArrays(gl.TRIANGLES,0,3);}
function resize(){const scale=Math.min(devicePixelRatio,1.5);canvas.width=Math.round(innerWidth*scale);canvas.height=Math.round(innerHeight*scale);draw();}
function loadShader(source,name){
 if(!gl)throw new Error('WebGL2対応ブラウザで開いてください。');
 const prepared=window.OuroborosShaderData.prepare(gl,source);let next=gl.createProgram(),vs,fs;
 try{vs=compile(gl.VERTEX_SHADER,vertex);fs=compile(gl.FRAGMENT_SHADER,prepared.fragment);gl.attachShader(next,vs);gl.attachShader(next,fs);gl.linkProgram(next);if(!gl.getProgramParameter(next,gl.LINK_STATUS))throw new Error(gl.getProgramInfoLog(next));}
 catch(error){gl.deleteProgram(next);prepared.dispose();throw error;}
 finally{if(vs)gl.deleteShader(vs);if(fs)gl.deleteShader(fs);}
 if(program)gl.deleteProgram(program);if(shaderData)shaderData.dispose();shaderData=prepared;program=next;shaderData.bind(program);uniforms={};
 for(const u of manifest.programs.ouroboros.uniforms){const loc=gl.getUniformLocation(program,u.name);uniforms[u.name]=value=>gl[u.setter](loc,typeof value==='number'?[value]:value);}
 draw();const phase=source.match(/const int PHASE\s*=\s*(\d+)/);status.textContent=name+(phase?' — 世代 '+String(Number(phase[1])+1).padStart(2,'0')+' / 24':'')+' を表示しています';
}
async function openFile(file){if(!file)return;const request=++loading;status.textContent='読み込んでいます…';try{const text=await file.text();if(request===loading)loadShader(text,file.name);}catch(error){if(request===loading)status.textContent='表示できませんでした: '+error.message;}}
document.getElementById('file').addEventListener('change',event=>openFile(event.target.files[0]));
addEventListener('dragover',event=>{event.preventDefault();document.body.classList.add('drop');});
addEventListener('dragleave',event=>{if(!event.relatedTarget)document.body.classList.remove('drop');});
addEventListener('drop',event=>{event.preventDefault();document.body.classList.remove('drop');openFile(event.dataTransfer.files[0]);});
canvas.addEventListener('pointermove',event=>{pointer=new Float32Array([event.clientX/innerWidth*2-1,1-event.clientY/innerHeight*2]);draw();});canvas.addEventListener('pointerleave',()=>{pointer.fill(0);draw();});
addEventListener('resize',resize);resize();
if(!gl)status.textContent='WebGL2対応ブラウザで開いてください。';
</script></body></html>
